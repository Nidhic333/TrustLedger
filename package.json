{"name":"multi-bank-kyc","version":"1.0.0","private":true,"type":"module","scripts":{"chain":"hardhat node --hostname 127.0.0.1","compile":"hardhat compile","deploy":"npm run compile && node scripts/deploy.mjs","seed":"node scripts/seed.mjs","dev":"concurrently -k \"node --watch backend/src/index.js\" \"vite frontend --host 127.0.0.1\"","build":"vite build frontend","test":"npm run compile && node --test --test-concurrency=1 tests/*.test.js","reset":"node scripts/seed.mjs"},"dependencies":{"cors":"^2.8.5","dotenv":"^17.2.0","express":"^5.1.0","react":"^19.1.0","react-dom":"^19.1.0","viem":"^2.38.0"},"devDependencies":{"concurrently":"^9.2.0","hardhat":"^3.0.0","typescript":"^5.9.0","vite":"^7.1.0"}}